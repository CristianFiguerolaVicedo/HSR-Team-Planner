# Copy to backend/.env (never commit it) and fill in the values from:
#   Discord: https://discord.com/developers/applications → your app → OAuth2
#   Google:  https://console.cloud.google.com → Google Auth Platform → Clients
# Redirect URIs to register (local): http://localhost:5173/login/oauth2/code/discord
#                                    http://localhost:5173/login/oauth2/code/google
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Production (Render) --------------------------------------------------------------
# Not read from this file: set them in Render's Environment tab (see render.yaml / README).
#   SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
#   SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD
#   PUBLIC_URL=https://<project>.vercel.app
# Production redirect URIs to add in Discord and Google:
#   https://<project>.vercel.app/login/oauth2/code/discord
#   https://<project>.vercel.app/login/oauth2/code/google
