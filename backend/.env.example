# Copy to backend/.env (never commit it) and fill in the values from:
#   Discord: https://discord.com/developers/applications → your app → OAuth2
#   Google:  https://console.cloud.google.com → Google Auth Platform → Clients
# Redirect URIs to register (local): http://localhost:5173/login/oauth2/code/discord
#                                    http://localhost:5173/login/oauth2/code/google
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
