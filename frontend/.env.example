# Leave unset: the site calls its own origin (/api), which Vite (dev) and Vercel (prod) forward to the backend.
# That's required for login (session and CSRF cookies). Only set it to point at another API without login.
# VITE_API_BASE_URL=https://example.com/api

# HSRWiki (sister project) for the "HSRWiki ↗" links. Defaults to https://hsr-wiki-frontend.vercel.app
# VITE_WIKI_URL=http://localhost:5174
